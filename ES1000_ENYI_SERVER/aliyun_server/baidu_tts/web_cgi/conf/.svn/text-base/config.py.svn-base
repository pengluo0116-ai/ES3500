#coding:utf-8

#########################################################################
#   系统运行需要的配置参数存储到该文件下面
#########################################################################

class conf:
    BAIDU_TOKEN_URL                     = "https://openapi.baidu.com/oauth/2.0/token"                       #获取ACCESS TOKEN接口网址
    BAIDU_GRAND_TYPE                    = "client_credentials"                                              #固定为client_credentials
    BAIDU_GETRADIO_URL                  = "http://tsn.baidu.com/text2audio"                                 #百度文字转语音接口

    CONF_PATH                   	= "/root/work/baidu_tts/conf/tts.conf"                              #配置文件路径

    MP3_DOWNLOAD_PAHT                   = "/var/web/download"

    WEB_UPLOAD_LEN_MAX                  = 61440                                                             #语音文字上传文件最大值

    REDIS_SERVER_IP                     = "127.0.0.1"                                                       #REDIS服务器IP
    REDIS_SERVER_PORT                   = 6379                                                              #REDIS服务器端口

    WEB_SERVER_NAME                     = "http://www.emblink.com:9091"
    WEB_DOWNLOAD_PATH                   = "download"
