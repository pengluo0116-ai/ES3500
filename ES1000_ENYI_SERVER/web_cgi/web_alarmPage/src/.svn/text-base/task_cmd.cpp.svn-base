#include "task_cmd.h"
using namespace std;

/*
    函数名称：cmd_getAlarmNum
    函数功能：获取指定月份的报警信息的数量
    传入参数：Json::Value &_jsonData {"display":1, "alarm_date":"201706"}
    传出数据：无
    注意事项：html页面接收数据 {"error":0, "data":"893"}
    编写人员：王凤龙
    编写时间：2017-06-19
*/
void cmd_getAlarmNum(Json::Value &_jsonData){
    /*参数校验*/
    if(_jsonData["alarm_date"].isNull() || !_jsonData["alarm_date"].isString() || _jsonData["alarm_date"].asString().size() <= 0x00){ err_msg("上传数据有误"); return; }

    /*生成数据库文件路径*/
    string db_path = string(ALARM_DATAPATH) + _jsonData["alarm_date"].asString() + ".db";

    /*校验数据库文件是否存在*/
    if(access(db_path.c_str(), F_OK)){ err_msg("401", "该月份没有报警信息"); return; }

    /*数据库操作*/
    DB_alarm db(db_path.c_str());
    if(db.init()){ err_msg("读取历史故障失败，请稍后再试[E1]"); return; }
    string numStr = "";
    int err = db.num(numStr);
    if(err){ err_msg("读取历史故障失败，请稍后再试[E2]"); return; }

    /*返回数据*/
    err_msg("0", numStr.c_str());
}

/*
    函数名称：cmd_getAlarmPData
    函数功能：获取指定页的报警信息
    传入参数：Json::Value &_jsonData {"display":2, "alarm_date":"201706", "page":0, "pnum":30}
    传出数据：无
    注意事项：无
    编写人员：王凤龙
    编写时间：2017-06-19
*/
void cmd_getAlarmPData(Json::Value &_jsonData){
    /*参数校验*/
    if(
        _jsonData["alarm_date"].isNull() || !_jsonData["alarm_date"].isString() || _jsonData["alarm_date"].asString().size()<=0x00 ||
        _jsonData["page"].isNull() || !_jsonData["page"].isInt() || _jsonData["page"].asInt()<0x00 ||
        _jsonData["pnum"].isNull() || !_jsonData["pnum"].isInt() || _jsonData["pnum"].asInt()<0x00
    ){ err_msg("上传数据有误"); return; }

    /*生成数据库文件路径*/
    string db_path = string(ALARM_DATAPATH) + _jsonData["alarm_date"].asString() + ".db";

    /*校验数据库文件是否存在*/
    if(access(db_path.c_str(), F_OK)){ err_msg("401", "该月份无报警信息"); return; }

    /*数据库操作*/
    Json::Value jsonList; jsonList.clear();

    DB_alarm db(db_path.c_str());
    if(db.init()){ err_msg("读取历史故障失败，请稍后再试[ED1]"); return; }
    int err = db.getPData(jsonList, _jsonData["page"].asInt(), _jsonData["pnum"].asInt());
    if(err){ err_msg("读取历史故障失败，请稍后再试[ED2]"); return; }

    /*返回数据*/
    Json::Value responst_json; responst_json.clear();
    if(jsonList.size() <= 0x00){ responst_json["num"] = 0; } else{ responst_json["num"] = jsonList.size();}
    responst_json["error"] = 0;
    responst_json["data"] = jsonList;

    Json::FastWriter fast_writer;
    cout<<"Content-type:text/html\r\n\r\n";
    cout<< fast_writer.write(responst_json) <<endl;
}