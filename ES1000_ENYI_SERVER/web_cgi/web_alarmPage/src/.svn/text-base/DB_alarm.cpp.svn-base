#include "DB_alarm.h"
using namespace std;

/*
    函数名称：DB_alarm
    函数功能：构造函数
    传入参数：const char *_dbPath
    传出数据：无
    注意事项：无
    编写人员：王凤龙
    编写时间：2017-06-19
*/
DB_alarm::DB_alarm(const char *_dbPath):dbPath(_dbPath){}

/*
    函数名称：~DB_alarm
    函数功能：析构函数
    传入参数：无
    传出数据：无
    注意事项：无
    编写人员：王凤龙
    编写时间：2017-06-19
*/
DB_alarm::~DB_alarm(){}

/*
    函数名称：init
    函数功能：初始化
    传入参数：无
    传出数据：
    注意事项：无
    编写人员：王凤龙
    编写时间：2017-06-19
*/
int DB_alarm::init(){
    /*参数校验*/
    if(this->dbPath.size() <= 0x00) return -0x01;

    return 0x00;
}

/*
    函数名称：num
    函数功能：获取报警信息数量
    传入参数：   
                std::string &_snum  获取到的数量转换成成字符串存储到该引用指向的存储空间
                int (*_fun)(void*,int,char**,char**) 获取数量回调函数  (默认)DB_alarm::_num_callback
    传出数据：
                 0      运行成功
                -1      回调函数为空
                -2      数据库操作失败
    注意事项：无
    编写人员：王凤龙
    编写时间：2017-06-19
*/
int DB_alarm::num(std::string &_snum, int (*_fun)(void*,int,char**,char**)){

    /*参数校验*/
    if(!_fun) return -0x01;                 //未设置回调函数

    /*数据库操作*/
    string sql = "SELECT COUNT(*) AS anum FROM alarm_info;";
    
    dbcontrl db(this->dbPath.c_str());
    if(db.exec(sql.c_str(), _fun, (void *)&_snum)) return -0x02;

    return 0x00;
}

/*
    函数名称：getPData
    函数功能：获取报警数据（分页）
    传入参数：
                Json::Value &jsonList                     获取到的数据存储到改引用指向的存储空间
                unsigned int _page                      页码
                unsigned int _pageNum                   每页数据量
                int (*_fun)(void*,int,char**,char**)    获取数据回调函数 (默认)DB_alarm::_getPData_callback
    传出数据：
    注意事项：无
    编写人员：王凤龙
    编写时间：2017-06-19
*/
int DB_alarm::getPData(Json::Value &jsonList, unsigned int _page, unsigned int _pageNum, int (*_fun)(void*,int,char**,char**)){
    /*参数校验*/
    if(!_fun) return -0x01;                 //未设置回调函数

    /*数据库操作*/
    ostringstream sql; sql.str("");
    sql << "SELECT dev_id, dev_name, ds_dx, lou_ceng, status, people, kaceng, kunren, up_alarm, down_alarm, run_door, speeding, power, alarm_time FROM alarm_info ORDER BY id desc "
        << "LIMIT " << _page * _pageNum << ", " << _pageNum;
    
    jsonList.clear();
    dbcontrl db(this->dbPath.c_str());
    if(db.exec(sql.str().c_str(), _fun, (void *)&jsonList)) return -0x02;
    return 0x00;
}

/*
    函数名称：_num_callback
    函数功能：获取报警信息数量回调函数
    传入参数：
                data 调用该函数的父函数传给该函数的值
                argc 一条查询记录中，列数
                argv 查询到结果以字符串列表的形式存到改变量中
                azColName 一条查询结果中，以字符串列表的形式，存储所有的列的名称
    传出数据：保留 0
    注意事项：无
    编写人员：王凤龙
    编写时间：2017-06-19
*/
int DB_alarm::_num_callback(void *data, int argc, char **argv, char **azColName){
    *(string *)data = (argv[0] ? argv[0] : "0");

    return 0x00;
}

/*
    函数名称：_getPData_callback
    函数功能：获取报警数据（分页）回调函数
    传入参数：
                data 调用该函数的父函数传给该函数的值
                argc 一条查询记录中，列数
                argv 查询到结果以字符串列表的形式存到改变量中
                azColName 一条查询结果中，以字符串列表的形式，存储所有的列的名称
    传出数据：保留 0
    注意事项：无
    编写人员：王凤龙
    编写时间：2017-06-19
*/
int DB_alarm::_getPData_callback(void *data, int argc, char **argv, char **azColName){
    Json::Value *_jsonData = (Json::Value *)data;
    Json::Value jsonTmp;

    try{
        jsonTmp["dev_id"] = argv[0];
        jsonTmp["dev_name"] = string(argv[1]);
        jsonTmp["ds_dx"] = string(argv[2]);
        jsonTmp["lou_ceng"] = string(argv[3]);
        jsonTmp["status"] = string(argv[4]);
        jsonTmp["people"] = string(argv[5]);
        jsonTmp["kaceng"] = string(argv[6]);
        jsonTmp["kunren"] = string(argv[7]);
        jsonTmp["up_alarm"] = string(argv[8]);
        jsonTmp["run_door"] = string(argv[9]);
        jsonTmp["down_alarm"] = string(argv[10]);
        jsonTmp["speeding"] = string(argv[11]);
        jsonTmp["power"] = string(argv[12]);
        jsonTmp["time"] = string(argv[13]);
    }catch(...){ return 0x00; }
    
    _jsonData->append(jsonTmp);

    return 0x00;
}