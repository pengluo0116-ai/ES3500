/*
    函数名称：get_device_all
    函数功能：获取所有设备信息
    传入参数：
                Json::Value &josnList    获取到的数据存储到该引用指向的存储空间
                int callback(void *data, int argc, char **argv, char **azColName)
    传出数据：0 运行成功 非0 运行失败
    注意事项：无
    编写人员：王凤龙
    编写时间：2017-05-24
*/
int get_device_all(Json::Value &jsonList, int (*callback)(void *, int, char **, char **)){
    ostringstream sql;
    sql << "SELECT id, gid, dev_name, url, x, y, note, madein, property, mainter, mainter_tel, address FROM dev_info;";

    jsonList.clear();
    dbcontrl db(DBPATH);
    if(db.exec(sql.str().c_str(), callback, (void *)&jsonList)){ return -0x01; }

    return 0x00;
}

