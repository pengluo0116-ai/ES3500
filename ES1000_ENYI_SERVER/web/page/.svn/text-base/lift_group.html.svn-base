<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <script type="text/javascript" src="/js/jquery-1.8.3.min.js"></script>
    <script type="text/javascript" src="/js/layer/layer.js"></script>
    <script type="text/javascript" src="/js/layer/extend/layer.ext.js"></script>
    <script type="text/javascript" src="/js/JS.js"></script>
    <style type="text/css">
        .l_bd{ margin: auto 20px auto 20px; }
        .d_box{ width: 390px; float: left; background-color:#E9ECF3; margin: 5px; }
        .d_title{ width: 390px; height: 30px; line-height: 30px; font-family: 微软雅黑; font-size: 14px; text-indent: 10px; background-color:#249CBF; text-overflow:ellipsis; white-space:nowrap; overflow:hidden; }
        .d_real{ width: 390px; height: 108px; margin: 10px auto 10px auto; }
        .d_real_l{ margin-left: 10px; width: 150px; height: 106px; border:1px solid #B0B0A0; background-color:#E2E2FA; float: left; }
        .d_real_l_lc{ width: 100%; height: 55px; text-align: center; line-height: 55px; font-size: 48px; font-weight: bolder; }
        .d_real_l_st{ widows: 100%; height: 40px; margin: 5px auto 5px auto; } 
        .d_real_l_st div{ width:36px; height: 36px; border:2px solid white; margin: 0 5px 0 5px; float: left; background-repeat: no-repeat; }
        .d_real_tb{ margin-right: 10px; width: 206px; border:2px solid white; border-width: 2px 2px 0 0; float: right; font-size: 12px; }
        .d_real_tb td{ height: 19px; border:2px solid white; border-width: 0 0 2px 2px; line-height: 19px; text-indent: 5px; font-family: 宋体; }
        .d_real_td1, .d_real_td1_t{ width: 60px; }
        .d_real_td1_t{ background-color:#249CBF; }
        /*.d_real_td1_t{ background-color:#17B808; }*/
        .d_real_td2{ width: 142px; }
        .d_alarm{ width: 370px; height: 30px; margin: 0 auto 10px auto; line-height: 26px;}
        .d_alarm_l{ width: 81px; height: 26px; border:2px solid white; float: left; text-align: center; }
        .d_alarm_r{ width: 283px; height: 26px; border:2px solid white; border-width: 2px 2px 2px 0; float:right; text-indent: 20px; }
    </style>
</head>
<body>
    <!--<div>
        <input type="button" onclick="button_test()" value="测试" />
    </div>-->
    <!--<div id="aaa">ddd</div>-->
    <div id="qtbd" class="l_bd">
        <!--设备开始-->

        <!--设备结束-->
    </div>
</body>
</html>

<script type="text/javascript">

var qt_liftGroup_options = {
    "jsonReal" : null,
    "dateTime" : 0
};

/*禁用滚轮*/
function disabledMouseWheel() {  
  if (document.addEventListener) {  
    document.addEventListener('DOMMouseScroll', scrollFunc, false);  
  }//W3C  
  window.onmousewheel = document.onmousewheel = scrollFunc;//IE/Opera/Chrome  
}  
function scrollFunc(evt) {  
  return false;  
}  
window.onload=disabledMouseWheel; 

/*禁用右键*/
document.oncontextmenu = function(){
    event.returnValue = false;
}

/*禁用选择*/
document.onselectstart = function(){
    event.returnValue = false;
} 

$(document).ready(function(){
    if(!QT_devOfGroup_load()) return;
    resp_real();
});

/*
    函数名称：QT_create_lift_box
    函数功能：创建一个设备的显示盒子
    传入参数：
                dev_classOBJ    设备对象
                qzstr           盒子前缀
                css_display     是否显示
    传出数据：无
    注意事项：无
    编写人员：王凤龙
    编写时间：2107-05-26
*/
function QT_create_lift_box(dev_classOBJ, qzstr, css_display){
    var tmp = "";
    tmp += '<div class="d_box" id="'+ qzstr +'_'+ dev_classOBJ.id +'" style="display:'+ css_display +';">';
    tmp += '<div class="d_title" id="'+ qzstr +'_title_'+ dev_classOBJ.id +'" style="background-color:#B1B1B1;">'+ window.parent.get_dev_gname(dev_classOBJ) +'</div>';
    tmp += '<div class="d_real">';
    tmp += '<div class="d_real_l">';
    tmp += '<div class="d_real_l_lc" id="'+ qzstr +'_lc_'+ dev_classOBJ.id +'">0</div>';
    tmp += '<div class="d_real_l_st">';
    tmp += '<div id="'+ qzstr +'_img_status_'+ dev_classOBJ.id +'" style="background-image:url(/image/uds.jpg); background-position: 0px -33px;"><input type="hidden" value="-1" /></div>';
    tmp += '<div id="'+ qzstr +'_img_person_'+ dev_classOBJ.id +'" style="background-image:url(/image/people.jpg); background-position: 0px -33px;"></div>';
    tmp += '<div id="'+ qzstr +'_img_door_'+ dev_classOBJ.id +'" style="background-image:url(/image/doorclose.gif)"><input type="hidden" value="-1" /></div>';
    tmp += '</div>';
    tmp += '</div>';
    tmp += '<table class="d_real_tb" border="0" cellpadding="0" cellspacing="0">';
    tmp += '<tr>';
    tmp += '<td class="d_real_td1_t">设备ID</td>';
    tmp += '<td class="d_real_td2">'+ dev_classOBJ.id +'</td>';
    tmp += '</tr>';
    tmp += '<tr>';
    tmp += '<td class="d_real_td1">运行状态</td>';
    tmp += '<td class="d_real_td2" id="'+ qzstr +'_status_'+ dev_classOBJ.id +'">--</td>';
    tmp += '</tr>';
    tmp += '<tr>';
    tmp += '<td class="d_real_td1">有无人</td>';
    tmp += '<td class="d_real_td2" id="'+ qzstr +'_person_'+ dev_classOBJ.id +'">--</td>';
    tmp += '</tr>';
    tmp += '<tr>';
    tmp += '<td class="d_real_td1">开关门</td>';
    tmp += '<td class="d_real_td2" id="'+ qzstr +'_door_'+ dev_classOBJ.id +'">--</td>';
    tmp += '</tr>';
    tmp += '<tr>';
    tmp += '<td class="d_real_td1">更新时间</td>';
    tmp += '<td class="d_real_td2" id="'+ qzstr +'_time_'+ dev_classOBJ.id +'">--</td>';
    tmp += '</tr>';
    tmp += '</table>';
    tmp += '</div>';
    tmp += '<div class="d_alarm">';
    tmp += '<div class="d_alarm_l">报警信息</div>';
    tmp += '<div class="d_alarm_r" id="'+ qzstr +'_alarm_'+ dev_classOBJ.id +'">离线</div>';
    tmp += '</div>';
    tmp += '</div>';

    return tmp;
}

/*
    函数名称：QT_create_lift_body
    函数功能：创建设备显示区
    传入参数：无
    传出数据：无
    注意事项：无
    编写人员：王凤龙
    编写时间：2017-05-26
*/
function QT_create_lift_body(devList_obj){
    var tmp = "";
    for(var i=0x00; i<devList_obj.length; i++) tmp += QT_create_lift_box(devList_obj[i], "larm", "none");
    for(var i=0x00; i<devList_obj.length; i++) tmp += QT_create_lift_box(devList_obj[i], "lrt", "block");
    $("#qtbd").empty();
    $("#qtbd").html(tmp);
}

/*
    函数名称：QT_devOfGroup_load
    函数功能；加载指定组的设备
    传入参数：无
    传出数据：无
    注意事项：无
    编写人员：王凤龙
    编写时间：2017-05-27
*/
function QT_devOfGroup_load(){
    /*获取组对象*/
    var groupID = ~~getQueryString("id"); 
    var groupCalss = window.parent.get_group_classOBJ(groupID);
    if(groupCalss == null){ layer.msg("获取组信息失败"); return false; }

    /*获取设备信息*/
    var glist = [];
    window.parent.get_groupAllDev_classOBJ(groupCalss, glist);
    if(glist.length <= 0x00){ layer.msg("该组下没有添加设备"); return false; }

    QT_create_lift_body(glist);
    return true;
}

/*
    函数名称：QT_devTimeOut_check
    函数功能：单台设备超时检测
    传入参数：jsonData   单台设备实时信息
    传出数据：true 超时 false 没有超时
    注意事项：无
    编写人员：王凤龙
    编写时间：2017-05-26
*/
function QT_dev_isTimeOut(jsonData){
    var ndate = new Date(Date.parse(qt_liftGroup_options.dateTime.replace(/-/g, "/"))); 
    var odate = new Date(Date.parse(jsonData["Parameters"]["Recv_time"].replace(/-/g, "/"))); 

    var sjc = ndate.getTime() - odate.getTime(); 
    if(sjc/1000 > 120) return true;

    return false;
}

/*
    函数名称：QT_getAlarm_ont
    函数功能：获取单台设备的报警信息
    传入参数：jsonData   单台设备实时信息
    传出数据：报警信息字符串
    注意事项：无
    编写人员：王凤龙
    编写时间：2017-05-26
*/
function QT_getAlarm_out(josnData){
    var alarmStr = "";
    alarmStr += ~~josnData["Alarm"]["Kunren"] ? "困人&nbsp" : "";
    alarmStr += ~~josnData["Alarm"]["Power"] ? "掉电&nbsp" : "";
    alarmStr += ~~josnData["Alarm"]["UP_Alarm"] ? "冲顶&nbsp" : "";
    alarmStr += ~~josnData["Alarm"]["Down_Alarm"] ? "蹲底&nbsp" : "";
    alarmStr += ~~josnData["Alarm"]["Speeding"] ? "超速&nbsp" : "";
    alarmStr += ~~josnData["Alarm"]["Run_door"] ? "开门走梯&nbsp" : "";
    alarmStr += ~~josnData["Alarm"]["Kaceng"] ? "卡层" : "";
    return alarmStr;
}

/*
    函数名称：QT_devUpdata_one
    函数功能：单台设备刷新数据
    传入参数：
                jsonData 单台设备的实时信息
                qzstr    前缀信息
    传出数据：无
    注意事项：无
    编写人员：王凤龙
    编写时间：2017-05-26
*/
function QT_devUpdate_one(jsonData, qzstr){
    var id = jsonData["Parameters"]["ID"];
    /*楼层*/
    var louceng = "";
    louceng = ~~jsonData["State"]["DS_DX"] ? "" : "-";
    $("#"+ qzstr +"_lc_" + id).html(louceng + jsonData["State"]["Lou_Ceng"]);

    /*运行状态*/
    switch(~~jsonData["State"]["status"]){
        case 0: 
                if($("#" + qzstr + "_img_status_" + id).find("input:eq(0)").val() != jsonData["State"]["status"]){ 
                    $("#"+ qzstr +"_status_" + id).html("停"); 
                    $("#" + qzstr + "_img_status_" + id).css("background-position", "0px -33px");  
                    $("#" + qzstr + "_img_status_" + id).find("input:eq(0)").val(jsonData["State"]["status"]);
                }
                break;
        case 1: 
                if($("#" + qzstr + "_img_status_" + id).find("input:eq(0)").val() != jsonData["State"]["status"]){
                    $("#"+ qzstr +"_status_" + id).html("上"); 
                    $("#" + qzstr + "_img_status_" + id).css("background-position", "0px 0px"); 
                    $("#" + qzstr + "_img_status_" + id).find("input:eq(0)").val(jsonData["State"]["status"]);
                }
                break;
        default: 
                if($("#" + qzstr + "_img_status_" + id).find("input:eq(0)").val() != jsonData["State"]["status"]){ 
                    $("#"+ qzstr +"_status_" + id).html("下"); 
                    $("#" + qzstr + "_img_status_" + id).css("background-position", "0px -68px"); 
                    $("#" + qzstr + "_img_status_" + id).find("input:eq(0)").val(jsonData["State"]["status"]);
                }
                break;
    }

    /*有无人*/
    switch(~~jsonData["State"]["People"]){
        case 0: 
                $("#" + qzstr + "_person_" + id).html("无人"); 
                break;
        default: 
                $("#" + qzstr + "_person_" + id).html("有人"); 
                break;
    }

    /*有无人困人图标显示*/
    if(~~jsonData["Alarm"]["Kunren"]){ $("#" + qzstr + "_img_person_" + id).css("background-position", "0px -68px");}
    else{
        switch(~~jsonData["State"]["People"]){
            case 0: $("#" + qzstr + "_img_person_" + id).css("background-position", "0px -33px"); break;
            default:  $("#" + qzstr + "_img_person_" + id).css("background-position", "0px 0px"); break;
        }
    }

    /*开关门*/
    switch(~~jsonData["State"]["Door"]){
        case 0: 
            if($("#" + qzstr + "_door_" + id).find("input:eq(0)").val() != jsonData["State"]["Door"]){
                $("#" + qzstr + "_door_" + id).html("关门"); 
                $("#" + qzstr + "_img_door_" + id).css("background-image", "url(/image/doorclose.gif)");
                $("#" + qzstr + "_door_" + id).find("input:eq(0)").val(jsonData["State"]["Door"]);
            }
            break;
        default: 
            if($("#" + qzstr + "_door_" + id).find("input:eq(0)").val() != jsonData["State"]["Door"]){
                $("#" + qzstr + "_door_" + id).html("开门"); 
                $("#" + qzstr + "_img_door_" + id).css("background-image", "url(/image/doorkai.gif)");
                $("#" + qzstr + "_door_" + id).find("input:eq(0)").val(jsonData["State"]["Door"]);
            }
            break;
    }

    /*更新时间*/
    $("#" + qzstr + "_time_" + id).html(jsonData["Parameters"]["Recv_time"]);

    /*故障状态初始化*/
    $("#" + qzstr + "_title_" + id).css("background-color", "#249CBF");
    $("#" + qzstr + "_alarm_" + id).html("");

    /*故障判断*/
    var alarm = QT_getAlarm_out(jsonData);
    if(alarm.length > 0x00){ 
        $("#" + qzstr + "_alarm_" + id).html(alarm);
        $("#" + qzstr + "_title_" + id).css("background-color", "#FF3232");
    }

    /*超时检测*/
    if(QT_dev_isTimeOut(jsonData)){ 
        $("#" + qzstr + "_alarm_" + id).html(QT_getAlarm_out(jsonData));
        $("#" + qzstr + "_title_" + id).css("background-color", "#B0B0A0");
        $("#" + qzstr + "_alarm_" + id).html("离线");
    }
}

/*
    函数名称：QT_devUpdate_rone
    函数功能：更新单台设备信息
    传入参数：jsonData   单台设备信息
    传入数据：无
    注意事项：无
    编写人员：王凤龙
    编写时间：2017-05-26
*/
function QT_devUpdate_rone(jsonData){
    var id = jsonData["Parameters"]["ID"];

    /*获取设备实时box控件*/
    var obj_box_real = $("#lrt_" + id);
    var obj_box_alarm = $("#larm_" + id);

    /*检测设备是否存在*/
    if(obj_box_alarm.length <= 0x00) return;

    /*检测是否离线或正常*/
    if(QT_dev_isTimeOut(jsonData) || ~~jsonData["Alarm"]["Y_N"]==0){ 
        obj_box_alarm.css("display", "none");
        obj_box_real.css("display", "block");
        QT_devUpdate_one(jsonData, "lrt");
    }

    else{
        obj_box_real.css("display", "none");
        obj_box_alarm.css("display", "block");
        QT_devUpdate_one(jsonData, "larm");
    } 
}

/*
    函数名称：QT_realDataLoad
    函数功能：实时数据加载
    传入参数：realStr   从服务器返回的数据
    传出数据：
    注意事项：无
    编写人员：王凤龙
    编写时间：2017-05-26
*/
function QT_realDataLoad(realStr){ 
    /*数据格式化*/
    var jsonData;
    try{ jsonData = eval('('+ realStr +')'); }catch(e){ alert(e); }

    /*检测错误值*/
    if(jsonData["error"] != 0x00) return;

    /*获取实时数据*/
    try{
        qt_liftGroup_options.jsonReal = eval('('+ jsonData["data"] +')');
        qt_liftGroup_options.dateTime = jsonData["datetime"];
    }catch(e){ return; }

    /*实时处理*/
    for(var i=0x00; i<qt_liftGroup_options.jsonReal.length; i++){
        QT_devUpdate_rone(qt_liftGroup_options.jsonReal[i]);
    }

    /*树形图展示*/
    var realList = qt_liftGroup_options.jsonReal;
    var id = 0;
    for(var i=0x00; i<realList.length; i++){
        id = realList[i]["Parameters"]["ID"];
        window.parent.set_tree_point_status(id, 0);
        if(~~realList[i]["Alarm"]["Y_N"]) window.parent.set_tree_point_status(id, 1);
        if(QT_dev_isTimeOut(realList[i])) window.parent.set_tree_point_status(id, 2);
    }
}

/*
    函数名称：resp_real
    函数功能：实时数据交互
    传入参数：无
    传出数据：无
    注意事项：与QT端实时索取数据
    编写人员：王凤龙
    编写时间：2017-05-26
*/
function resp_real(){
    try{
        var getStr = window.parent.mywebkit.get_realData(); 
        QT_realDataLoad(getStr);
    }catch(e){ location.href = location.href; }
    setTimeout(resp_real, 1000);
}
</script>