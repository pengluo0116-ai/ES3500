#include "obj_title.h"
#include "real_cont.h"
#include "window.h"
#define DEBUG 1

/*
    函数名称：obj_title
    函数功能：构造函数
    传入参数：QWidget *_parent
    传出数据：无
    注意事项：无
    编写人员：王凤龙
    编写时间：2017-05-17
*/
obj_title::obj_title(QWidget *_parent):QLabel(_parent), dev_all(0), dev_online(0), dev_alarm(0){}

/*
    函数名称：~obj_title
    函数功能：析构函数
    传入参数：无
    传出数据：无
    注意事项：无
    编写人员：王凤龙
    编写时间：2017-05-17
*/
obj_title::~obj_title(){}

/*
    函数功能：create_viewFrame
    函数功能：创建视图框架
    传入参数：无
    传出数据：
    注意事项：无
    编写人员：王凤龙
    编写时间：2017-05-17
*/
int obj_title::create_viewFrame(){
    /*************************************************
        主界面
    *************************************************/
    /*创建窗体*/
    QHBoxLayout *layout_body = new QHBoxLayout(this);
    QLabel *label_title = new QLabel(tr("电梯运行实时监控系统"), this);
    QWidget *widget_real = new QWidget(this);
    QWidget *widget_radioCont = new QWidget(this);

    /*组装窗体*/
    layout_body->addWidget(label_title);
    layout_body->addWidget(widget_real);
    layout_body->addWidget(widget_radioCont);
    this->setLayout(layout_body);

    /*窗体样式*/
    layout_body->setMargin(0);
    layout_body->setSpacing(0);
    label_title->setFixedSize(380, 80);
    label_title->setAlignment(Qt::AlignHCenter | Qt::AlignVCenter); 
    label_title->setStyleSheet("color:#0580B9; font-size:32px; font-weight:bold;");
    widget_real->setMaximumWidth(600);
    this->setStyleSheet("border-bottom: 6px solid #0580B9; background-color:white;");
    this->setMaximumHeight(80);
    this->setMinimumHeight(80);

    /*************************************************
        实时电梯数据显示--电梯总数，在线电梯，报警数量
    *************************************************/
    /*创建窗体*/
    QVBoxLayout *real_layout_body = new QVBoxLayout(widget_real);
    QWidget *real_widget_top = new QWidget(widget_real);               //占位
    QWidget *real_widget_bottom = new QWidget(widget_real);
    
    QHBoxLayout *real_layout_lift = new QHBoxLayout(widget_real);
    this->lable_liftNum_all = new QLabel(tr("电梯总数：0台"), widget_real);
    this->lable_liftNum_online = new QLabel(tr("在线电梯：0台"), widget_real);
    this->lable_liftNum_alarm = new QLabel(tr("报警数量：0台"), widget_real);
    
    /*组装窗体*/
    real_layout_body->addWidget(real_widget_top);
    real_layout_body->addWidget(real_widget_bottom);
    widget_real->setLayout(real_layout_body);

    real_layout_lift->addWidget(lable_liftNum_all);
    real_layout_lift->addWidget(lable_liftNum_online);
    real_layout_lift->addWidget(lable_liftNum_alarm);
    real_widget_bottom->setLayout(real_layout_lift);

    /*窗体样式*/
    real_widget_top->setStyleSheet("border-width:0;");
    real_widget_bottom->setStyleSheet("border-width:0; font-size:18px;"); 

    /*************************************************
        音频按钮
    *************************************************/
    /*读取配置文件，获取按钮默认运行状态*/
    int btn_enable = 0x00;
    Json::Value jsonConf_btn; jsonConf_btn.clear();
    if(JreadConf(TITLE_BUTTON_CONF, jsonConf_btn)) btn_enable = 0x00;
    else{ btn_enable = jsonConf_btn["enable"].asInt(); }

    /*创建窗体*/
    QHBoxLayout *radioCont_layout_body = new QHBoxLayout(widget_radioCont);
    QWidget *radionCont_widget_left = new QWidget(widget_radioCont);
    this->button_radio = new obj_title_button(btn_enable, widget_radioCont);
    this->button_radio->init();

    /*组装窗体*/
    radioCont_layout_body->addWidget(radionCont_widget_left);
    radioCont_layout_body->addWidget(this->button_radio);
    widget_radioCont->setLayout(radioCont_layout_body);
    radionCont_widget_left->setStyleSheet("border-width:0;");
    // this->button_radio->setMaximumWidth(80);

    /*绑定按钮到父窗口*/
    if(Global_window::mwindow){ Global_window::mwindow->checkout_radioBtn(this->button_radio ); }

    return 0x00;
}

/*
    函数名称：init
    函数功能：初始化函数
    传入参数：无
    传出数据：
                 0  运行成功
                -1  创建窗体构架失败
    注意事项：该类在生成对象后，需要先运行该函数
    编写人员：王凤龙
    编写时间：2017-05-17
*/
int obj_title::init(){
    /*创建窗体框架*/
    if(this->create_viewFrame()) return -0x01;

    /*关联槽函数*/
    QObject::connect(this->button_radio, SIGNAL(clicked()), this, SLOT(button_click()));
    connect(this, SIGNAL(s_status(unsigned short, unsigned short, unsigned short)), this, SLOT(t_status(unsigned short, unsigned short, unsigned short)));

    /*将本对象关联到实时处理*/
    real_cont::set_objTitle(this);

    return 0x00;
}

/*
    函数名称：status
    函数功能：实时状态设置
    传入参数：
                unsigned short _devAll      设备总数
                unsigned short _devOnline   在线设备数量
                unsigned short _devAlarm    故障设备数量
    传出数据：保留 0
    注意事项：无
    编写人员：王凤龙
    编写时间：2017-05-20
*/
int obj_title::status(unsigned short _devAll, unsigned short _devOnline, unsigned short _devAlarm){
    emit this->s_status(_devAll, _devOnline, _devAlarm);
    return 0x00;
}

/*
    函数名称：s_status
    函数功能：信号--实时状态设置
    传入参数：
                unsigned short _devAll      设备总数
                unsigned short _devOnline   在线设备数量
                unsigned short _devAlarm    故障设备数量
    传出数据：无
    注意事项：无
    编写人员：王凤龙
    编写时间：2017-06-13
*/
// int obj_title::s_status(unsigned short _devAll, unsigned short _devOnline, unsigned short _devAlarm){}

/*
    函数名称：t_status
    函数功能：槽--实时状态设置
    传入参数：
                unsigned short _devAll      设备总数
                unsigned short _devOnline   在线设备数量
                unsigned short _devAlarm    故障设备数量
    传出数据：无
    注意事项：无
    编写人员：王凤龙
    编写时间：2017-06-13
*/
void obj_title::t_status(unsigned short _devAll, unsigned short _devOnline, unsigned short _devAlarm){
    /*设备总数*/
    if(this->dev_all != _devAll){ 
        this->dev_all = _devAll; 
        this->lable_liftNum_all->setText(tr("电梯总数：") + QString::number(_devAll) + tr("台")); 
    }

    /*在线设备*/
    if(this->dev_online != _devOnline){ 
        this->dev_online = _devOnline;
        this->lable_liftNum_online->setText(tr("在线电梯：") + QString::number(_devOnline) + tr("台")); 
    }

    /*故障设备*/
    if(this->dev_alarm != _devAlarm){ 
        this->dev_alarm = _devAlarm;
        this->lable_liftNum_alarm->setText(tr("报警数量：") + QString::number(_devAlarm) + tr("台")); 
        if(this->dev_alarm) this->lable_liftNum_alarm->setStyleSheet("color:red;");
        else this->lable_liftNum_alarm->setStyleSheet("color:black;");
    }

    /*按钮状态*/
    if(Global_window::mwindow){
        if(_devAlarm) Global_window::mwindow->radioBtn_setAlarm();
        else Global_window::mwindow->radioBtn_clearAlarm();
    }
}

/*
    函数名称：button_click
    函数功能：标题栏按钮点击事件
    传入参数：无
    传出数据：无
    注意事项：无
    编写人员：王凤龙
    编写时间：2017-05-22
*/
void obj_title::button_click(){
    switch(this->button_radio->isOpen()){
        case 0: this->button_radio->open(); break;
        default: this->button_radio->close(); break;
    }
}